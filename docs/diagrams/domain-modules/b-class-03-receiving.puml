@startuml b-class-03-receiving
title 食序 FoodFlow｜進貨與批次入庫管理
caption FR-06、FR-07｜目前正式整合類別圖的局部視圖
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft JhengHei
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classHeaderBackgroundColor #ECECEC
skinparam classBorderColor #777777
skinparam linetype polyline
skinparam dpi 192
together {
class "供應商\nSupplier" as Supplier <<entity>> {
  +id : int
  +name : str
  +contact_person : str | None
  +phone : str | None
  +other_contact : str | None
  +is_active : bool
  -- 方法 --

}

class "員工\nEmployee" as Employee <<entity>> {
  +id : int
  +username : str
  +password_hash : str
  +name : str
  +role : EmployeeRole
  +is_active : bool
  +token_version : int
  +created_at : datetime
  -- 方法 --

}

class "食材\nIngredient" as Ingredient <<entity>> {
  +id : int
  +name : str
  +category_id : int
  +unit : str
  +storage_method : StorageType
  +safety_stock_quantity : Decimal
  +is_active : bool
  +created_at : datetime
  -- 方法 --

}

class "儲存位置\nStorageLocation" as StorageLocation <<entity>> {
  +id : int
  +code : str
  +name : str
  +storage_type : StorageType
  +description : str | None
  +is_active : bool
  -- 方法 --

}
}
Supplier -[hidden]right-> Employee
Employee -[hidden]right-> Ingredient
Ingredient -[hidden]right-> StorageLocation
together {
class "進貨服務\nGoodsReceiptService" as GoodsReceiptService <<service>> {
  -_repository : GoodsReceiptRepository
  -_ledger : StockLedger
  -_uow : UnitOfWork
  -_clock : Clock
  -- 方法 --
  +create(supplier_id, receipt_date, items, operator_id) : GoodsReceipt
  +update(receipt_id, supplier_id, receipt_date, items) : GoodsReceipt
  +confirm(receipt_id, operator_id) : GoodsReceipt
}

class "進貨單\nGoodsReceipt" as GoodsReceipt <<entity>> {
  +id : int
  +supplier_id : int
  +receipt_date : date
  +status : GoodsReceiptStatus
  +created_by_id : int
  +created_at : datetime
  +confirmed_at : datetime | None
  +/receipt_number : str <<property, readOnly>>
  -- 方法 --
  +receipt_number() : str <<property getter>>
}

class "進貨明細\nGoodsReceiptItem" as GoodsReceiptItem <<entity>> {
  +id : int
  +receipt_id : int
  +ingredient_id : int
  +quantity : Decimal | None
  +unit_price : Decimal | None
  +expiry_date : date | None
  +location_id : int | None
  +note : str | None
  -- 方法 --

}

abstract class "庫存總帳契約\nStockLedger" as StockLedger <<abstract>> {

  -- 方法 --
  +receive(item, op) : InventoryTransaction
  +deduct(batch, quantity, tx_type, op, is_non_fefo) : InventoryTransaction
  +move(batch, to_location_id, op) : BatchLocationChange | None
}
}
GoodsReceiptService -[hidden]right-> GoodsReceipt
GoodsReceipt -[hidden]right-> GoodsReceiptItem
GoodsReceiptItem -[hidden]right-> StockLedger
together {
class "庫存批次\nInventoryBatch" as InventoryBatch <<entity>> {
  +id : int
  +batch_number : str
  +source_item_id : int
  +ingredient_id : int
  +expiry_date : date
  +received_date : date
  +current_location_id : int
  +unit_price : Decimal | None
  +initial_quantity : Decimal
  +remaining_quantity : Decimal
  -- 方法 --

}

class "庫存異動\nInventoryTransaction" as InventoryTransaction <<entity>> {
  +id : int
  +operation_group_id : UUID
  +batch_id : int
  +type : TransactionType
  +quantity_delta : Decimal
  +quantity_before : Decimal
  +quantity_after : Decimal
  +operator_id : int
  +occurred_at : datetime
  +reason : str
  +is_non_fefo : bool
  +reverses_transaction_id : int | None
  -- 方法 --

}
}
InventoryBatch -[hidden]right-> InventoryTransaction
Supplier -[hidden]down-> GoodsReceiptService
GoodsReceiptService -[hidden]down-> InventoryBatch
Employee "1" -- "0..*" GoodsReceipt : created_by
Employee "1" -- "0..*" InventoryTransaction : operator
GoodsReceipt "1" -- "0..*" GoodsReceiptItem : receipt / items
GoodsReceiptItem "1" -- "0..1" InventoryBatch : source_item
Ingredient "1" -- "0..*" GoodsReceiptItem : ingredient
Ingredient "1" -- "0..*" InventoryBatch : ingredient
InventoryBatch "1" -- "0..*" InventoryTransaction : batch
InventoryTransaction "0..1" -- "0..1" InventoryTransaction : reverses
StorageLocation "0..1" -- "0..*" GoodsReceiptItem : location
StorageLocation "1" -- "0..*" InventoryBatch : current_location
Supplier "1" -- "0..*" GoodsReceipt : supplier
GoodsReceiptService ..> GoodsReceipt : «use»
GoodsReceiptService ..> GoodsReceiptItem : «use»
GoodsReceiptService ..> StockLedger : _ledger
StockLedger ..> InventoryBatch : «use»
StockLedger ..> InventoryTransaction : «use»
StockLedger ..> GoodsReceiptItem : «use»
legend bottom left
  實線為領域關聯；虛線為使用依賴。類別成員與多重度直接沿用完整圖。
  僅顯示兩端都在本視圖內的關聯；完整關聯請參照 b-class-diagram。
  PNG／SVG 與 draw.io 使用固定排版，PlantUML 自動排版可能不同。
  receipt_number() 標示 @property getter 定義；實際使用 receipt.receipt_number 讀取。
endlegend
@enduml
