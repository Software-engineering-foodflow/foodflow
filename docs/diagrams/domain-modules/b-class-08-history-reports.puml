@startuml b-class-08-history-reports
title 食序 FoodFlow｜異動紀錄與統計領域類別圖
caption FR-17、FR-18｜局部視圖，完整關聯見原始總覽圖
left to right direction
hide circle
skinparam linetype polyline
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft JhengHei
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBorderColor #64748B
skinparam ArrowColor #475569
skinparam ArrowFontSize 12
skinparam nodesep 55
skinparam ranksep 100
skinparam padding 6
skinparam dpi 120

class "員工\nEmployee" as Employee <<entity>> #F2EFF8 {
  +id : int
  +username : str
  +password_hash : str
  +name : str
  +role : EmployeeRole
  +is_active : bool
  +token_version : int
  +created_at : datetime
}

class "儲存位置\nStorageLocation" as StorageLocation <<entity>> #EFF6FF {
  +id : int
  +code : str
  +name : str
  +storage_type : StorageType
  +description : str | None
  +is_active : bool
}

class "庫存批次\nInventoryBatch" as InventoryBatch <<entity>> #FFF7ED {
  +id : int
  +batch_number : str
  +source_item_id : int
  +ingredient_id : int
  +expiry_date : date
  +received_date : date
  +current_location_id : int
  +unit_price : Decimal | None
  +initial_quantity : Decimal
  +remaining_quantity : Decimal
}

class "庫存異動\nInventoryTransaction" as InventoryTransaction <<entity>> #FFF7ED {
  +id : int
  +operation_group_id : UUID
  +batch_id : int
  +type : TransactionType
  +quantity_delta : Decimal
  +quantity_before : Decimal
  +quantity_after : Decimal
  +operator_id : int
  +occurred_at : datetime
  +reason : str
  +is_non_fefo : bool
  +reverses_transaction_id : int | None
}

class "報廢紀錄\nWasteRecord" as WasteRecord <<entity>> #FFF7ED {
  +id : int
  +batch_id : int
  +transaction_id : int
  +quantity : Decimal
  +reason : WasteReason
  +note : str | None
  +loss_amount : Decimal | None
  +operator_id : int
  +occurred_at : datetime
}

class "位置變更紀錄\nBatchLocationChange" as BatchLocationChange <<entity>> #FFF7ED {
  +id : int
  +batch_id : int
  +from_location_id : int
  +to_location_id : int
  +operator_id : int
  +occurred_at : datetime
  +reason : str
}

Employee "1" -- "0..*" BatchLocationChange : operator
Employee "1" -- "0..*" InventoryTransaction : operator
Employee "1" -- "0..*" WasteRecord : operator
InventoryBatch "1" -- "0..*" BatchLocationChange : batch
InventoryBatch "1" -- "0..*" InventoryTransaction : batch
InventoryBatch "1" -- "0..*" WasteRecord : batch
InventoryTransaction "0..1" -- "0..1" InventoryTransaction : reverses
InventoryTransaction "1" -- "0..1" WasteRecord : transaction
StorageLocation "1" -- "0..*" BatchLocationChange : from_location
StorageLocation "1" -- "0..*" BatchLocationChange : to_location
StorageLocation "1" -- "0..*" InventoryBatch : current_location


legend bottom left
  數量歷程與位置歷程分開呈現。
  統計由現有批次及紀錄彙整，不新增報表資料表。
  reverses、from_location 與 to_location 皆保留原關聯。
  ─────────────────────
  + 公開屬性；/ 衍生唯讀屬性；T | None 可為空
  端點數字為原圖多重度；交叉處不代表關聯或分支
  共用類別可出現在不同模組圖；屬性均完整保留
endlegend
@enduml
