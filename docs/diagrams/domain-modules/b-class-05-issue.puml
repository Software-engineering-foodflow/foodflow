@startuml b-class-05-issue
title 食序 FoodFlow｜食材領用與消耗登記
caption FR-10、FR-11｜目前正式整合類別圖的局部視圖
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft JhengHei
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classHeaderBackgroundColor #ECECEC
skinparam classBorderColor #777777
skinparam linetype polyline
skinparam dpi 192
together {
class "食材\nIngredient" as Ingredient <<entity>> {
  +id : int
  +name : str
  +category_id : int
  +unit : str
  +storage_method : StorageType
  +safety_stock_quantity : Decimal
  +is_active : bool
  +created_at : datetime
  -- 方法 --

}

class "員工\nEmployee" as Employee <<entity>> {
  +id : int
  +username : str
  +password_hash : str
  +name : str
  +role : EmployeeRole
  +is_active : bool
  +token_version : int
  +created_at : datetime
  -- 方法 --

}

class "儲存位置\nStorageLocation" as StorageLocation <<entity>> {
  +id : int
  +code : str
  +name : str
  +storage_type : StorageType
  +description : str | None
  +is_active : bool
  -- 方法 --

}
}
Ingredient -[hidden]right-> Employee
Employee -[hidden]right-> StorageLocation
together {
class "庫存批次\nInventoryBatch" as InventoryBatch <<entity>> {
  +id : int
  +batch_number : str
  +source_item_id : int
  +ingredient_id : int
  +expiry_date : date
  +received_date : date
  +current_location_id : int
  +unit_price : Decimal | None
  +initial_quantity : Decimal
  +remaining_quantity : Decimal
  -- 方法 --

}

class "領用服務\nIssueService" as IssueService <<service>> {
  -_repository : IssueRepository
  -_ledger : StockLedger
  -_uow : UnitOfWork
  -_clock : Clock
  -_default : BatchSelectionStrategy
  -_manual : BatchSelectionStrategy
  -- 方法 --
  +suggest(ingredient_id, quantity, lines) : Suggestion
  +issue(ingredient_id, lines, idempotency_key, operator_id) : IssueResult
}

abstract class "庫存總帳契約\nStockLedger" as StockLedger <<abstract>> {

  -- 方法 --
  +receive(item, op) : InventoryTransaction
  +deduct(batch, quantity, tx_type, op, is_non_fefo) : InventoryTransaction
  +move(batch, to_location_id, op) : BatchLocationChange | None
}
}
InventoryBatch -[hidden]right-> IssueService
IssueService -[hidden]right-> StockLedger
together {
class "庫存異動\nInventoryTransaction" as InventoryTransaction <<entity>> {
  +id : int
  +operation_group_id : UUID
  +batch_id : int
  +type : TransactionType
  +quantity_delta : Decimal
  +quantity_before : Decimal
  +quantity_after : Decimal
  +operator_id : int
  +occurred_at : datetime
  +reason : str
  +is_non_fefo : bool
  +reverses_transaction_id : int | None
  -- 方法 --

}
}
Ingredient -[hidden]down-> InventoryBatch
InventoryBatch -[hidden]down-> InventoryTransaction
Employee "1" -- "0..*" InventoryTransaction : operator
Ingredient "1" -- "0..*" InventoryBatch : ingredient
InventoryBatch "1" -- "0..*" InventoryTransaction : batch
InventoryTransaction "0..1" -- "0..1" InventoryTransaction : reverses
StorageLocation "1" -- "0..*" InventoryBatch : current_location
IssueService ..> InventoryBatch : «use»
IssueService ..> StockLedger : _ledger
StockLedger ..> InventoryBatch : «use»
StockLedger ..> InventoryTransaction : «use»
legend bottom left
  實線為領域關聯；虛線為使用依賴。類別成員與多重度直接沿用完整圖。
  僅顯示兩端都在本視圖內的關聯；完整關聯請參照 b-class-diagram。
  PNG／SVG 與 draw.io 使用固定排版，PlantUML 自動排版可能不同。
  FEFO 協作沿用 IssueService；不補畫總圖未展開的策略或 Repository 類別。
endlegend
@enduml
