@startuml b-class-02-master-storage
title 食序 FoodFlow｜基本資料與儲存位置管理
caption FR-03～FR-05｜目前正式整合類別圖的局部視圖
top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Microsoft JhengHei
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classHeaderBackgroundColor #ECECEC
skinparam classBorderColor #777777
skinparam linetype polyline
skinparam dpi 192
together {
class "供應商\nSupplier" as Supplier <<entity>> {
  +id : int
  +name : str
  +contact_person : str | None
  +phone : str | None
  +other_contact : str | None
  +is_active : bool
  -- 方法 --

}

class "食材分類\nIngredientCategory" as IngredientCategory <<entity>> {
  +id : int
  +code : str
  +name : str
  +description : str | None
  +is_active : bool
  +created_at : datetime
  -- 方法 --

}

class "食材\nIngredient" as Ingredient <<entity>> {
  +id : int
  +name : str
  +category_id : int
  +unit : str
  +storage_method : StorageType
  +safety_stock_quantity : Decimal
  +is_active : bool
  +created_at : datetime
  -- 方法 --

}
}
Supplier -[hidden]right-> IngredientCategory
IngredientCategory -[hidden]right-> Ingredient
together {
class "員工\nEmployee" as Employee <<entity>> {
  +id : int
  +username : str
  +password_hash : str
  +name : str
  +role : EmployeeRole
  +is_active : bool
  +token_version : int
  +created_at : datetime
  -- 方法 --

}

class "儲存位置\nStorageLocation" as StorageLocation <<entity>> {
  +id : int
  +code : str
  +name : str
  +storage_type : StorageType
  +description : str | None
  +is_active : bool
  -- 方法 --

}

abstract class "庫存總帳契約\nStockLedger" as StockLedger <<abstract>> {

  -- 方法 --
  +receive(item, op) : InventoryTransaction
  +deduct(batch, quantity, tx_type, op, is_non_fefo) : InventoryTransaction
  +move(batch, to_location_id, op) : BatchLocationChange | None
}
}
Employee -[hidden]right-> StorageLocation
StorageLocation -[hidden]right-> StockLedger
together {
class "庫存批次\nInventoryBatch" as InventoryBatch <<entity>> {
  +id : int
  +batch_number : str
  +source_item_id : int
  +ingredient_id : int
  +expiry_date : date
  +received_date : date
  +current_location_id : int
  +unit_price : Decimal | None
  +initial_quantity : Decimal
  +remaining_quantity : Decimal
  -- 方法 --

}

class "位置變更紀錄\nBatchLocationChange" as BatchLocationChange <<entity>> {
  +id : int
  +batch_id : int
  +from_location_id : int
  +to_location_id : int
  +operator_id : int
  +occurred_at : datetime
  +reason : str
  -- 方法 --

}
}
InventoryBatch -[hidden]right-> BatchLocationChange
Supplier -[hidden]down-> Employee
Employee -[hidden]down-> InventoryBatch
Employee "1" -- "0..*" BatchLocationChange : operator
Ingredient "1" -- "0..*" InventoryBatch : ingredient
IngredientCategory "1" -- "0..*" Ingredient : category
InventoryBatch "1" -- "0..*" BatchLocationChange : batch
StorageLocation "1" -- "0..*" BatchLocationChange : from_location
StorageLocation "1" -- "0..*" BatchLocationChange : to_location
StorageLocation "1" -- "0..*" InventoryBatch : current_location
StockLedger ..> InventoryBatch : «use»
StockLedger ..> BatchLocationChange : «use»
legend bottom left
  實線為領域關聯；虛線為使用依賴。類別成員與多重度直接沿用完整圖。
  僅顯示兩端都在本視圖內的關聯；完整關聯請參照 b-class-diagram。
  PNG／SVG 與 draw.io 使用固定排版，PlantUML 自動排版可能不同。
  移位依賴沿用總圖 StockLedger；不新增總圖未列的資料維護或移位 Service。
endlegend
@enduml
