xitX=1;exitY=0.5;entryX=1;entryY=0.4962962962962963;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Uow" target="Session"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1603" y="1015"/><mxPoint x="1603" y="1567"/></Array></mxGeometry></mxCell><mxCell id="e12-label" value="commit／rollback" style="text;html=1;align=center;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1250" y="1522" width="360" height="27" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Session" target="Db"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e13-label" value="psycopg／SQL" style="text;html=1;align=center;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="785" y="1699" width="360" height="27" as="geometry"/></mxCell><mxCell id="legend" value="實線：呼叫／資料存取；虛線：Clock 共用支援依賴。&lt;br&gt;開發：Vite 代理 /api；展示：FastAPI 提供前端靜態檔。&lt;br&gt;預警在查詢時計算，InAppNotifier 同步回傳站內預警結果。" style="text;html=1;align=left;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="80" y="1990" width="1450" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>