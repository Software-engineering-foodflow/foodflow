<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="foodflow-architecture" name="FoodFlow 軟體架構圖"><mxGraphModel dx="1660" dy="2145" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2145" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="食序 FoodFlow｜軟體架構圖" style="text;html=1;align=center;fontFamily=Microsoft JhengHei;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="12" width="1100" height="55" as="geometry"/></mxCell><mxCell id="Frontend" value="前端客戶端層（電腦／平板瀏覽器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3ED;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;container=0;" vertex="1" parent="1"><mxGeometry x="390" y="175" width="880" height="190" as="geometry"/></mxCell><mxCell id="Backend" value="FastAPI 後端應用｜單一應用、依功能模組分層" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="1580" height="1285" as="geometry"/></mxCell><mxCell id="User" value="&lt;b&gt;餐廳操作人員：管理者／一般員工&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=22;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="600" height="54" as="geometry"/></mxCell><mxCell id="Web" value="&lt;b&gt;React＋TypeScript＋Vite／Mantine&lt;/b&gt;&lt;br&gt;頁面與表單 → TanStack Query hooks → feature API&lt;br&gt;shared/api/client.ts 統一請求與錯誤處理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="218" width="840" height="122" as="geometry"/></mxCell><mxCell id="Api" value="&lt;b&gt;API 入口與安全控管&lt;/b&gt;&lt;br&gt;/api/v1・router.py／Pydantic schemas&lt;br&gt;JWT Cookie 驗證・角色權限（RBAC）&lt;br&gt;統一錯誤回應（DomainError／驗證錯誤）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EFF9;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="475" width="780" height="150" as="geometry"/></mxCell><mxCell id="Service" value="&lt;b&gt;Service 商業邏輯層&lt;/b&gt;&lt;br&gt;帳號權限｜基本資料與儲存位置&lt;br&gt;進貨與批次｜批次庫存查詢&lt;br&gt;食材領用｜效期與低庫存預警&lt;br&gt;報廢與盤點｜異動紀錄與統計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3ED;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="715" width="780" height="210" as="geometry"/></mxCell><mxCell id="Domain" value="&lt;b&gt;領域規則與策略&lt;/b&gt;&lt;br&gt;FefoStrategy／ManualStrategy&lt;br&gt;AlertRuleFactory／AlertRule&lt;br&gt;共用效期與低庫存判定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="695" width="340" height="190" as="geometry"/></mxCell><mxCell id="Notifier" value="&lt;b&gt;站內預警 Adapter&lt;/b&gt;&lt;br&gt;AlertNotifier → InAppNotifier&lt;br&gt;同步回傳 AlertResult&lt;br&gt;供預警首頁顯示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="945" width="340" height="145" as="geometry"/></mxCell><mxCell id="Clock" value="&lt;b&gt;Clock（共用時間）&lt;/b&gt;&lt;br&gt;SystemClock／FixedClock&lt;br&gt;統一時間與臺灣日期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EFF8;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1250" y="725" width="340" height="145" as="geometry"/></mxCell><mxCell id="Uow" value="&lt;b&gt;UnitOfWork（交易控制）&lt;/b&gt;&lt;br&gt;SqlAlchemyUnitOfWork&lt;br&gt;整筆成功提交、例外回滾" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EFF8;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1250" y="940" width="340" height="150" as="geometry"/></mxCell><mxCell id="Ledger" value="&lt;b&gt;StockLedger&lt;/b&gt;&lt;br&gt;SqlAlchemyStockLedger&lt;br&gt;批次列鎖、餘量與位置寫入&lt;br&gt;進貨／領用／報廢／盤點／沖銷" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3ED;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="350" y="1175" width="430" height="190" as="geometry"/></mxCell><mxCell id="Repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;各模組介面＋SQLAlchemy 實作&lt;br&gt;基本資料及單據查詢與維護&lt;br&gt;批次查詢、預警資料與統計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EFF9;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="850" y="1175" width="430" height="190" as="geometry"/></mxCell><mxCell id="Session" value="&lt;b&gt;SQLAlchemy Session／ORM&lt;/b&gt;&lt;br&gt;共用資料庫連線與模型&lt;br&gt;資料存取 flush；交易由 UnitOfWork 管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="1500" width="780" height="135" as="geometry"/></mxCell><mxCell id="Db" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;12 張表・PK／FK／唯一及檢查限制&lt;br&gt;批次、單據、庫存異動、位置及報廢紀錄&lt;br&gt;Docker Compose＋持久化 Volume" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=18;whiteSpace=wrap;html=1;fillColor=#EAF3ED;strokeColor=#64748B;fontColor=#1F2937;fontFamily=Microsoft JhengHei;fontSize=20;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="1780" width="780" height="170" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="User" target="Frontend"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Web" target="Api"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2-label" value="同源 HTTP／JSON・/api/v1&lt;br&gt;JWT 以 HttpOnly Cookie 傳遞" style="text;html=1;align=center;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="860" y="404" width="360" height="54" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Api" target="Service"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e3-label" value="驗證後呼叫" style="text;html=1;align=center;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="760" y="652" width="360" height="27" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;exitX=0;exitY=0.3571428571